{
  "name": "agent-cli-contract-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite site",
    "build:site": "vite build site --outDir ../dist/site --emptyOutDir",
    "build:cli": "cargo build --release",
    "build": "npm run build:site && npm run build:cli",
    "test": "cargo test && npm run build:site && playwright test",
    "test:claims": "npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
