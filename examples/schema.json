{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-cli-contract.sociobot.in/schema/v1.json",
  "title": "Agent CLI Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command", "fixtures"],
  "properties": {
    "version": { "const": 1 },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "modes": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "redact_env": { "type": "array", "items": { "type": "string" } },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "modes": { "type": "array", "items": { "enum": ["text", "tty", "json"] } },
          "stdin": { "type": "string" },
          "env": { "type": "object", "additionalProperties": { "type": "string" } },
          "files": { "type": "object", "additionalProperties": { "type": "string" } },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exit": { "type": "integer" },
              "stdout_contains": { "type": "array", "items": { "type": "string" } },
              "stderr_contains": { "type": "array", "items": { "type": "string" } },
              "error_code": { "type": "string" }
            }
          },
          "recover_args": { "type": "array", "items": { "type": "string" } },
          "idempotent": { "type": "boolean" },
          "detect_nondeterminism": { "type": "boolean" },
          "allow_nondeterministic_fields": { "type": "array", "items": { "type": "string" } },
          "allow_network": { "type": "boolean" },
          "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 300000, "default": 10000 }
        }
      }
    }
  }
}
